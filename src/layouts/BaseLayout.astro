---
/**
 * Document shell for every page: `<head>` metadata, the self-hosted font
 * (preloaded, ACF-06), skip link, header, `<main>`, contact band, and
 * footer. The only client script is the Cloudflare Web Analytics beacon,
 * included when PUBLIC_WEB_ANALYTICS is on (production builds).
 */
import outfitLatin from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url';
import {PUBLIC_WEB_ANALYTICS} from 'astro:env/server';

import ContactBand from '../components/site/ContactBand.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import {SITE, WEB_ANALYTICS, pageTitle} from '../lib/config';
import '../styles/global.css';

interface Props {
  /** Page title; omit on the home page. */
  title?: string;
  /** Meta description; defaults to the site description. */
  description?: string;
  /** Show the "Let's Work Together" band; off for the résumé page. */
  showContactBand?: boolean;
}

const {
  title,
  description = SITE.description,
  showContactBand = true,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url);
const socialImage = new URL('/social-card.jpg', SITE.url);
const beaconConfig = JSON.stringify({token: WEB_ANALYTICS.token});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle(title)}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1b2130" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="preload"
      href={outfitLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle(title)} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Garrison Hutcherson’s GH logo with a mint orbit"
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {showContactBand && <ContactBand />}
    <SiteFooter />
    {PUBLIC_WEB_ANALYTICS && (
      <script
        type="module"
        src={WEB_ANALYTICS.scriptSrc}
        data-cf-beacon={beaconConfig}
      />
    )}
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 600;
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }

  main:focus {
    outline: none;
  }
</style>
