---
/**
 * About page: headshot beside the long-form intro from
 * src/content/pages/about.md (photo first on phones).
 */
import {render} from 'astro:content';

import AboutGlobe from '../components/about/AboutGlobe.astro';
import AboutSpace from '../components/about/AboutSpace.astro';
import PageHeader from '../components/site/PageHeader.astro';
import Button from '../components/ui/Button.astro';
import Portrait from '../components/ui/Portrait.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {RESUME_PATH, SITE} from '../lib/config';
import {getPage} from '../lib/content';

const page = await getPage('about');
const {Content} = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <div class="scene">
    <AboutSpace />
    <AboutGlobe />
    <div class="heading">
      <PageHeader eyebrow="About" title={`About ${SITE.name}`} />
    </div>
    <div class="container body">
      <div class="layout">
        <div class="photo">
          <Portrait variant="card" width={320} eager />
        </div>
        <div>
          <div class="prose">
            <Content />
          </div>
          <div class="ctas">
            <Button href="/experience/" icon="briefcase">
              See my experience
            </Button>
            <Button href={RESUME_PATH} variant="secondary" icon="file-text">
              View Résumé
            </Button>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .scene {
    position: relative;
    overflow: clip;
  }

  .heading {
    position: relative;
  }

  .heading > :global(.page-header) {
    background-color: transparent;
  }

  .body {
    position: relative;
    padding-bottom: var(--space-8);
  }

  .layout {
    display: grid;
    gap: var(--space-6);
  }

  .photo {
    width: min(57%, 15rem);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  @media (width >= 56rem) {
    .layout {
      grid-template-columns: 20rem minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }

    .photo {
      width: 100%;
    }
  }
</style>
