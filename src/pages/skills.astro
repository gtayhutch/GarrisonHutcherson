---
/** Skills page: every skill group as a card. */
import PageHeader from '../components/site/PageHeader.astro';
import SkillGroups from '../components/skills/SkillGroups.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {getSkillGroups} from '../lib/content';

const groups = await getSkillGroups();
---

<BaseLayout
  title="Skills"
  description="Garrison Hutcherson's skills: client success, technical troubleshooting, payments and financial software, SaaS tools, web, and communication."
>
  <PageHeader
    eyebrow="Skills"
    title="What I bring to a support team"
    intro="The people skills of client success, the technical depth to reproduce and escalate real bugs, and hands-on time with the tools support teams use every day."
  />
  <div class="container body">
    <section class="evidence" aria-labelledby="skills-evidence">
      <h2 id="skills-evidence">See these skills in practice</h2>
      <ul>
        <li>
          <a href="/case-studies/">
            Customer communication and log analysis in support cases
          </a>
        </li>
        <li>
          <a href="/projects/#webhook-troubleshooting">
            API troubleshooting and engineering escalation sample
          </a>
        </li>
        <li>
          <a href="/projects/#settlement-reconciliation">
            SQL and settlement reconciliation sample
          </a>
        </li>
        <li>
          <a href="/projects/#support-writing">Technical writing samples</a>
        </li>
      </ul>
    </section>
    <SkillGroups groups={groups} variant="grid" headingLevel="h2" />
  </div>
</BaseLayout>

<style>
  .body {
    padding-bottom: var(--space-8);
  }

  .evidence {
    margin-bottom: var(--space-6);
  }

  .evidence ul {
    margin-top: var(--space-3);
  }
</style>
