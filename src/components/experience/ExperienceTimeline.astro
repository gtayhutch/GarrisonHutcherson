---
/**
 * Vertical timeline of employers. `compact` shows the summary and current
 * title (home page); `full` lists every role with its highlights.
 */
import type {Experience} from '../../lib/content';
import IconTile from '../ui/IconTile.astro';

interface Props {
  /** Employers, most recent first. */
  entries: Experience[];
  /** Level of detail. */
  variant?: 'compact' | 'full';
}

const {entries, variant = 'compact'} = Astro.props;
---

<ol class:list={['timeline', `timeline-${variant}`]} role="list">
  {entries.map(({data}) => {
    const [latest] = data.roles;
    return (
      <li class="item">
        <span class="dot" aria-hidden="true" />
        <article class="card">
          <IconTile
            name={data.icon}
            size={variant === 'compact' ? 'sm' : 'md'}
          />
          <div class="body">
            <header class="head">
              <div>
                {variant === 'compact' ? (
                  <>
                    <h3 class="title">{latest?.title}</h3>
                    <p class="company">{data.company}</p>
                  </>
                ) : (
                  <>
                    <h2 class="title">{data.company}</h2>
                    <p class="company">{data.location}</p>
                  </>
                )}
              </div>
              <p class="period">{data.period}</p>
            </header>
            {variant === 'compact' ? (
              <p class="summary">{data.summary}</p>
            ) : (
              <ol class="roles" role="list">
                {data.roles.map(role => (
                  <li class="role">
                    <div class="role-head">
                      <h3 class="role-title">{role.title}</h3>
                      {role.period && <p class="role-period">{role.period}</p>}
                    </div>
                    {role.team && <p class="team">{role.team}</p>}
                    {role.highlights.length > 0 && (
                      <ul class="highlights">
                        {role.highlights.map(item => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ol>
            )}
          </div>
        </article>
      </li>
    );
  })}
</ol>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0 0 0 var(--space-6);
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: var(--space-5);
    bottom: var(--space-5);
    left: 0.6rem;
    width: 2px;
    background: var(--color-border-strong);
  }

  .item {
    position: relative;
  }

  .dot {
    position: absolute;
    top: var(--space-5);
    left: calc(-1 * var(--space-6) + 0.2rem);
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--color-text-muted);
    border-radius: 50%;
    background: var(--color-bg);
  }

  .item:first-child .dot {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-accent-soft);
  }

  .card {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .body {
    flex: 1;
    min-width: 0;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  .title {
    font-size: var(--text-md);
  }

  .timeline-full .title {
    font-size: var(--text-lg);
  }

  .company {
    color: var(--color-text-muted);
  }

  .period,
  .role-period {
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 500;
    white-space: nowrap;
  }

  .summary {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .roles {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-4);
    padding: 0;
  }

  .role + .role {
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .role-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  .role-title {
    font-size: var(--text-base);
    font-weight: 600;
  }

  .role-period {
    background: transparent;
    color: var(--color-text-muted);
    padding: 0;
  }

  .team {
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .highlights {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding-left: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .highlights li::marker {
    color: var(--color-accent);
  }

  @media (width < 36rem) {
    .card {
      flex-direction: column;
      padding: var(--space-4);
    }
  }
</style>
