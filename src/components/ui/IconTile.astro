---
/** A rounded square tile holding an icon, used on cards and the timeline. */
import Icon, {type IconName} from './Icon.astro';

interface Props {
  /** Icon to show. */
  name: IconName;
  /** Tile size: `md` (48px) or `sm` (40px). */
  size?: 'md' | 'sm';
}

const {name, size = 'md'} = Astro.props;
---

<span class:list={['tile', `tile-${size}`]}>
  <Icon name={name} size={size === 'md' ? 24 : 20} />
</span>

<style>
  .tile {
    display: inline-grid;
    flex: none;
    place-items: center;
    border-radius: var(--radius-md);
    background: linear-gradient(145deg, var(--color-tile), #163130);
    box-shadow: 0 0 0 1px var(--color-border) inset;
    color: var(--color-tile-icon);
  }

  .tile-md {
    width: 3rem;
    height: 3rem;
  }

  .tile-sm {
    width: 2.5rem;
    height: 2.5rem;
  }
</style>
