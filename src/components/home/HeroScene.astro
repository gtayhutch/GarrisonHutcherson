---
/**
 * Decorative deep-space scene for the home hero, drawn as inline SVG at build
 * time and animated with CSS only (no JavaScript, ACF-02):
 * - three star layers drifting left at different speeds (parallax),
 * - a few twinkling stars,
 * - a slowly breathing mint/mauve aurora nebula and a ringed planet,
 * - shooting stars that streak across every 10-25 seconds.
 * Star positions come from a fixed-seed generator so every build is
 * identical. Visitors who prefer reduced motion get a still scene (the
 * global reduced-motion rule turns animations off; shooting stars are
 * hidden unless animating). Colors are illustration-only, not tokens.
 */

import {STAR_TILE_WIDTH, starLayer} from '../site/starfield';

const layers = [
  {name: 'far', stars: starLayer(110, [0.5, 0.9], 0.15, 3)},
  {name: 'mid', stars: starLayer(50, [0.9, 1.4], 0.25, 11)},
  {name: 'near', stars: starLayer(16, [1.5, 2.2], 0.35, 29)},
];
---

<svg
  class="space-scene"
  viewBox="0 0 1200 600"
  preserveAspectRatio="xMaxYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="space-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0d111b"></stop>
      <stop offset="0.6" stop-color="#151a27"></stop>
      <stop offset="1" stop-color="#1b2130"></stop>
    </linearGradient>
    <radialGradient id="space-nebula-pink" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#bae5c0" stop-opacity="0.3"></stop>
      <stop offset="1" stop-color="#86ae94" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="space-nebula-navy" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#3a5a8c" stop-opacity="0.36"></stop>
      <stop offset="1" stop-color="#272f40" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="space-nebula-violet" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#c77fc0" stop-opacity="0.34"></stop>
      <stop offset="1" stop-color="#e3c7e0" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="space-planet" cx="0.35" cy="0.3" r="0.75">
      <stop offset="0" stop-color="#4b6b6a"></stop>
      <stop offset="0.55" stop-color="#2a3a48"></stop>
      <stop offset="1" stop-color="#151b28"></stop>
    </radialGradient>
    <radialGradient id="space-glow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0.7" stop-color="#bae5c0" stop-opacity="0.32"></stop>
      <stop offset="1" stop-color="#bae5c0" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient
      id="space-trail"
      gradientUnits="userSpaceOnUse"
      x1="0"
      y1="0"
      x2="180"
      y2="0"
    >
      <stop offset="0" stop-color="#ffffff" stop-opacity="0"></stop>
      <stop offset="0.8" stop-color="#d4f2d8" stop-opacity="0.65"></stop>
      <stop offset="1" stop-color="#ffffff" stop-opacity="1"></stop>
    </linearGradient>
  </defs>

  <rect width="1200" height="600" fill="url(#space-sky)"></rect>

  <!-- Nebula -->
  <g class="nebula">
    <ellipse
      cx="830"
      cy="210"
      rx="420"
      ry="220"
      fill="url(#space-nebula-navy)"
    ></ellipse>
    <ellipse
      cx="980"
      cy="330"
      rx="300"
      ry="170"
      fill="url(#space-nebula-pink)"
    ></ellipse>
    <ellipse
      cx="640"
      cy="120"
      rx="260"
      ry="140"
      fill="url(#space-nebula-violet)"
    ></ellipse>
  </g>

  <!-- Drifting star layers: each holds two copies of one tile -->
  {layers.map(layer => (
    <g class={`stars stars-${layer.name}`}>
      {[0, STAR_TILE_WIDTH].map(offset => (
        <g transform={`translate(${String(offset)} 0)`}>
          {layer.stars.map(star => (
            <circle
              class={
                star.twinkle ? `twinkle t${String(star.twinkle)}` : undefined
              }
              cx={star.x}
              cy={star.y}
              r={star.r}
            />
          ))}
        </g>
      ))}
    </g>
  ))}

  <!-- Planet with an orbit ring -->
  <g class="planet">
    <circle cx="1090" cy="560" r="230" fill="url(#space-glow)"></circle>
    <path
      class="ring-back"
      d="M790 600c40-70 300-120 520-90"
      fill="none"
      stroke="#bae5c0"
      stroke-opacity="0.3"
      stroke-width="3"
    ></path>
    <circle cx="1090" cy="560" r="170" fill="url(#space-planet)"></circle>
    <path
      class="ring-front"
      d="M760 640c120-30 420-110 600-150"
      fill="none"
      stroke="#e3c7e0"
      stroke-opacity="0.7"
      stroke-width="2.5"
    ></path>
  </g>

  <!-- Shooting stars: hidden unless their animation is running -->
  {[1, 2, 3].map(n => (
    <g class={`shooting s${String(n)}`}>
      <line
        x1="0"
        y1="0"
        x2="180"
        y2="0"
        stroke="url(#space-trail)"
        stroke-width="2.5"
        stroke-linecap="round"
      />
      <circle cx="180" cy="0" r="2.6" fill="#ffffff" />
    </g>
  ))}
</svg>

<style>
  .space-scene {
    width: 100%;
    height: 100%;
  }

  .stars {
    fill: #f2f7f4;
    animation: drift linear infinite;
  }

  .stars-far {
    opacity: 0.55;
    animation-duration: 260s;
  }

  .stars-mid {
    opacity: 0.75;
    animation-duration: 150s;
  }

  .stars-near {
    opacity: 0.95;
    animation-duration: 85s;
  }

  .twinkle {
    animation: twinkle ease-in-out infinite;
  }

  .t1 {
    animation-duration: 3.2s;
  }

  .t2 {
    animation-duration: 4.6s;
    animation-delay: -1.3s;
  }

  .t3 {
    animation-duration: 5.8s;
    animation-delay: -2.7s;
  }

  .t4 {
    animation-duration: 7.4s;
    animation-delay: -4.1s;
  }

  .nebula {
    transform-box: fill-box;
    transform-origin: center;
    animation: breathe 18s ease-in-out infinite alternate;
  }

  /* Shooting stars travel down-left; at rest they are invisible. */
  .shooting {
    opacity: 0;
    animation: shoot linear infinite;
  }

  .s1 {
    animation-duration: 11s;
    animation-delay: 2s;
  }

  .s2 {
    animation-name: shoot-2;
    animation-duration: 17s;
    animation-delay: 7s;
  }

  .s3 {
    animation-name: shoot-3;
    animation-duration: 25s;
    animation-delay: 13s;
  }

  @keyframes drift {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-1200px);
    }
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0.25;
    }
  }

  @keyframes breathe {
    from {
      opacity: 0.75;
      transform: scale(1);
    }

    to {
      opacity: 1;
      transform: scale(1.06);
    }
  }

  @keyframes shoot {
    0% {
      opacity: 0;
      transform: translate(1150px, 40px) rotate(155deg);
    }

    1% {
      opacity: 1;
    }

    7% {
      opacity: 0;
      transform: translate(650px, 270px) rotate(155deg);
    }

    100% {
      opacity: 0;
      transform: translate(650px, 270px) rotate(155deg);
    }
  }

  @keyframes shoot-2 {
    0% {
      opacity: 0;
      transform: translate(900px, -20px) rotate(150deg);
    }

    1% {
      opacity: 0.9;
    }

    6% {
      opacity: 0;
      transform: translate(420px, 250px) rotate(150deg);
    }

    100% {
      opacity: 0;
      transform: translate(420px, 250px) rotate(150deg);
    }
  }

  @keyframes shoot-3 {
    0% {
      opacity: 0;
      transform: translate(1250px, 150px) rotate(160deg);
    }

    1% {
      opacity: 0.8;
    }

    8% {
      opacity: 0;
      transform: translate(700px, 350px) rotate(160deg);
    }

    100% {
      opacity: 0;
      transform: translate(700px, 350px) rotate(160deg);
    }
  }
</style>
