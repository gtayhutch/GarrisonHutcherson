---
/**
 * Home hero: headshot, eyebrow, headline with accent, intro, and the two
 * calls to action, over the SVG mountain scene (right side on wide screens,
 * a faded backdrop on narrow ones). The headshot sits above the text on
 * phones and to the right of it, over the scene, on wide screens.
 */
import type {Page} from '../../lib/content';
import {RESUME_PATH} from '../../lib/config';
import Button from '../ui/Button.astro';
import Portrait from '../ui/Portrait.astro';
import HeroScene from './HeroScene.astro';

interface Props {
  /** The `home` page entry holding the hero copy. */
  page: Page;
}

const {eyebrow = [], headline, headlineAccent, intro} = Astro.props.page.data;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="scene">
    <HeroScene />
  </div>
  <div class="container content">
    <div class="photo">
      <Portrait width={260} eager />
    </div>
    <div class="text">
      {eyebrow.length > 0 && (
        <ul class="eyebrow" role="list">
          {eyebrow.map(item => (
            <li>{item}</li>
          ))}
        </ul>
      )}
      <h1 id="hero-title">
        {headline}
        {headlineAccent && <span class="accent">{headlineAccent}</span>}
      </h1>
      {intro && <p class="intro">{intro}</p>}
      <div class="ctas">
        <Button href={RESUME_PATH} icon="file-text">
          View Résumé
        </Button>
        <Button href="/contact/" variant="secondary" icon="send">
          Get in Touch
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    isolation: isolate;
  }

  .scene {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.35;
    mask-image: linear-gradient(180deg, #000 0%, transparent 95%);
  }

  .content {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-7) var(--space-8);
  }

  .photo {
    width: 7rem;
  }

  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-4);
    color: var(--color-text);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .eyebrow li + li::before {
    content: '•';
    margin-right: var(--space-4);
    color: var(--color-accent);
  }

  h1 {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .accent {
    display: block;
    color: var(--color-accent);
  }

  .intro {
    max-width: 38rem;
    margin-top: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-md);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  @media (width >= 60rem) {
    .scene {
      left: 40%;
      opacity: 1;
      mask-image: linear-gradient(
        100deg,
        transparent 0%,
        #000 30%,
        #000 85%,
        transparent 100%
      );
    }

    .content {
      grid-template-columns: minmax(0, 44rem) 1fr;
      align-items: center;
      padding-block: var(--space-9);
    }

    .photo {
      grid-column: 2;
      grid-row: 1;
      justify-self: center;
      width: clamp(12rem, 18vw, 16.25rem);
    }

    .text {
      grid-column: 1;
      grid-row: 1;
    }
  }
</style>
