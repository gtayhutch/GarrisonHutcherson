---
/** "Key Strengths & Highlights": three cards with an icon, title, and body. */
import type {Strength} from '../../lib/content';
import IconTile from '../ui/IconTile.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  /** Strengths in display order. */
  strengths: Strength[];
}

const {strengths} = Astro.props;
---

<section class="strengths" aria-labelledby="strengths-title">
  <SectionHeading
    id="strengths-title"
    title="Key Strengths & Highlights"
    icon="star"
  />
  <ul class="cards" role="list">
    {strengths.map(({data}) => (
      <li class="card">
        <IconTile name={data.icon} />
        <div>
          <h3 class="title">{data.title}</h3>
          <p class="body">{data.body}</p>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .cards {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }

  .card {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .title {
    font-size: var(--text-md);
  }

  .body {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }

  @media (width >= 60rem) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
