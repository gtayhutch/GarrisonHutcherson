---
/**
 * The "Let's Work Together" band at the bottom of every page, with the
 * public email and GitHub link from CONTACT.
 */
import {CONTACT} from '../../lib/config';
import GitHubIcon from '../ui/GitHubIcon.astro';
import Icon from '../ui/Icon.astro';
---

<section class="contact-band" aria-labelledby="contact-band-title">
  <div class="container inner">
    <div class="heading">
      <p class="eyebrow">
        <Icon name="mail" size={20} />
        Contact
      </p>
      <h2 id="contact-band-title">Let's Work Together</h2>
    </div>
    <p class="pitch">
      I'm always interested in new opportunities in technical support, client
      success, and SaaS. Feel free to reach out.
    </p>
    <div class="links">
      <a class="email" href={`mailto:${CONTACT.email}`}>
        <Icon name="mail" size={18} />
        {CONTACT.email}
      </a>
      <a class="icon-link" href={CONTACT.github} aria-label="GitHub profile">
        <GitHubIcon />
      </a>
    </div>
  </div>
</section>

<style>
  .contact-band {
    border-top: 1px solid var(--color-border);
    background:
      radial-gradient(
        60rem 18rem at 85% 120%,
        rgb(95 212 160 / 16%),
        transparent 70%
      ),
      linear-gradient(180deg, #10302c, #0d2421);
  }

  .inner {
    display: grid;
    gap: var(--space-5);
    align-items: center;
    padding-block: var(--space-7);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  h2 {
    font-size: var(--text-xl);
  }

  .pitch {
    max-width: 34rem;
    color: var(--color-text-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .email,
  .icon-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 3rem;
    border: 1px solid var(--color-accent-border);
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    color: var(--color-text);
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .email {
    padding-inline: var(--space-4);
    overflow-wrap: anywhere;
  }

  .icon-link {
    justify-content: center;
    width: 3rem;
    border-color: var(--color-border-strong);
    background: transparent;
  }

  .email:hover,
  .icon-link:hover {
    border-color: var(--color-accent);
    background: rgb(95 212 160 / 22%);
    color: var(--color-text);
  }

  @media (width >= 60rem) {
    .inner {
      grid-template-columns: auto 1fr auto;
      gap: var(--space-7);
    }

    .pitch {
      padding-left: var(--space-7);
      border-left: 1px solid var(--color-border-strong);
    }
  }
</style>
